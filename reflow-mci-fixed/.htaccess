# ============================================
# Configuração Apache - Portal SMS Extrema/MG
# ============================================

# Compressão GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache de longo prazo para assets estáticos
<IfModule mod_expires.c>
  ExpiresActive On

  # CSS e JavaScript (1 ano com versionamento)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Fontes
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"

  # Imagens
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"

  # Manifest e favicon
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType image/x-icon "access plus 1 month"

  # HTML (sem cache - sempre buscar versão mais recente)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Headers de Cache adicionais
<IfModule mod_headers.c>
  # CSS e JS: cache imutável (apenas se usar versionamento)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imagens e fontes: cache de longo prazo
  <FilesMatch "\.(svg|png|jpg|jpeg|webp|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # HTML: sem cache
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Forçar HTTPS (se disponível)
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
# </IfModule>

# Bloquear acesso a arquivos sensíveis
<FilesMatch "(^\.htaccess|\.git|\.env)">
  Require all denied
</FilesMatch>

# UTF-8 como charset padrão
AddDefaultCharset UTF-8

# MIME types (caso servidor não reconheça)
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest .json
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>
